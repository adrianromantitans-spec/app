# Copy to .env.oauth (ignored by Git); populate privately, never commit the copy.
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_ORIGINS=["https://divzplit.com"]
TURNSTILE_ALLOWED_HOSTNAMES=["divzplit.com"]
TURNSTILE_REDIRECT_URLS=["https://divzplit.com/"]
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the Edge runtime.
# No Google Client Secret, JWT, OAuth verifier, or token belongs in frontend config.
