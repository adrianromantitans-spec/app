# Private copy only: .env.google-broker is ignored by Git.
GOOGLE_BROKER_ENABLED=false
GOOGLE_BROKER_CLIENT_ID=
GOOGLE_BROKER_CLIENT_SECRET=
# 32 random bytes encoded as 43 base64url characters, kept stable and private.
GOOGLE_BROKER_ENCRYPTION_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_ORIGINS=["https://divzplit.com"]
TURNSTILE_ALLOWED_HOSTNAMES=["divzplit.com"]
TURNSTILE_REDIRECT_URLS=["https://divzplit.com/"]
